{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/win7defender/specification.schema.json",
  "title": "ESF-001 clean-room behavioral specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "standard",
    "specification_id",
    "revision",
    "status",
    "title",
    "module",
    "source_identity",
    "authorization_record",
    "scope",
    "platform_constraints",
    "terms",
    "interfaces",
    "requirements",
    "evidence_claims",
    "unknowns",
    "permitted_public_references",
    "authors",
    "approvals",
    "release"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "standard": {"const": "ESF-001"},
    "specification_id": {
      "type": "string",
      "pattern": "^SPEC-[A-Z0-9][A-Z0-9-]*$"
    },
    "revision": {"type": "integer", "minimum": 1},
    "status": {
      "enum": ["draft", "technical-review", "expression-review", "released", "retired"]
    },
    "supersedes": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["specification_id", "revision"],
      "properties": {
        "specification_id": {"type": "string"},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "title": {"type": "string", "minLength": 1},
    "module": {"type": "string", "minLength": 1},
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_label", "sha256"],
      "properties": {
        "path_label": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "authorization_record": {"type": "string", "pattern": "^AUTH-"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded", "non_goals"],
      "properties": {
        "included": {"$ref": "#/$defs/nonEmptyStrings"},
        "excluded": {"$ref": "#/$defs/nonEmptyStrings"},
        "non_goals": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "platform_constraints": {"$ref": "#/$defs/nonEmptyStrings"},
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "meaning"],
        "properties": {
          "term": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1}
        }
      }
    },
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/interface"}
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "evidence_claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceClaim"}
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "impact"],
        "properties": {
          "id": {"type": "string", "pattern": "^UNK-[A-Z0-9][A-Z0-9-]*$"},
          "statement": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1}
        }
      }
    },
    "permitted_public_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "publisher", "identifier", "purpose"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "identifier": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/identity"}
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical", "expression", "scope"],
      "properties": {
        "technical": {"type": "array", "items": {"$ref": "#/$defs/approval"}},
        "expression": {"type": "array", "items": {"$ref": "#/$defs/approval"}},
        "scope": {"type": "array", "items": {"$ref": "#/$defs/approval"}}
      }
    },
    "release": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["released_date", "transfer_coordinator", "release_record_id"],
      "properties": {
        "released_date": {"type": "string", "format": "date"},
        "transfer_coordinator": {"$ref": "#/$defs/identity"},
        "release_record_id": {"type": "string", "pattern": "^REL-[A-Z0-9][A-Z0-9-]*$"}
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "decision", "date", "statement"],
      "properties": {
        "reviewer": {"$ref": "#/$defs/identity"},
        "decision": {"const": "approved"},
        "date": {"type": "string", "format": "date"},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "summary", "abi", "inputs", "outputs", "preconditions"],
      "properties": {
        "id": {"type": "string", "pattern": "^IF-[A-Z0-9][A-Z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["function", "data", "file", "protocol", "resource", "ui-state"]},
        "summary": {"type": "string", "minLength": 1},
        "abi": {"type": ["string", "null"]},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/value"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/value"}},
        "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "meaning"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "interface_ids", "title", "statement", "conditions", "outputs",
        "errors", "side_effects", "ordering", "confidence", "evidence_ids", "test_oracle"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9-]*$"},
        "interface_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "title": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "errors": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "side_effects": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "ordering": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "test_oracle": {"type": "string", "minLength": 1}
      }
    },
    "evidenceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "method", "confidence", "limitations"],
      "properties": {
        "id": {"type": "string", "pattern": "^EVID-[A-Z0-9][A-Z0-9-]*$"},
        "claim": {"type": "string", "minLength": 1},
        "method": {
          "enum": [
            "bounded-static-review",
            "controlled-black-box-test",
            "controlled-instruction-emulation",
            "platform-format-metadata",
            "corroborated-public-documentation"
          ]
        },
        "confidence": {"enum": ["high", "medium", "low"]},
        "limitations": {"type": "string", "minLength": 1}
      }
    }
  }
}
